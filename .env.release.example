# Copy this file to ".env.release" and set real values before publishing.
# Example:
#   cp .env.release.example .env.release
#   set -a && source .env.release && set +a

# Azure DevOps PAT with Marketplace (Manage) scope and organization set to
# "All accessible organizations".
VSCE_PAT=replace_with_marketplace_pat

# Optional safety guard. If set, the publish script verifies this matches
# package.json "publisher" to prevent publishing under the wrong identity.
VSCE_PUBLISHER=agenticsuno
