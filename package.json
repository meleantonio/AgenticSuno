{
    "name": "agentic-suno",
    "displayName": "AgenticSuno",
    "publisher": "agenticsuno",
    "description": "Adaptive AI Music for Coding Agents",
    "version": "0.0.1",
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/meleantonio/AgenticSuno.git"
    },
    "license": "UNLICENSED",
    "keywords": [
        "music",
        "ai",
        "coding",
        "agent",
        "background",
        "productivity",
        "suno",
        "lyria",
        "audio"
    ],
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "agenticSuno.start",
                "title": "AgenticSuno: Start Music"
            },
            {
                "command": "agenticSuno.stop",
                "title": "AgenticSuno: Stop Music"
            },
            {
                "command": "agenticSuno.pause",
                "title": "AgenticSuno: Pause Music"
            },
            {
                "command": "agenticSuno.resume",
                "title": "AgenticSuno: Resume Music"
            },
            {
                "command": "agenticSuno.togglePlayPause",
                "title": "AgenticSuno: Toggle Play/Pause"
            },
            {
                "command": "agenticSuno.skip",
                "title": "AgenticSuno: Skip Track"
            },
            {
                "command": "agenticSuno.showPlayer",
                "title": "AgenticSuno: Show Player"
            },
            {
                "command": "agenticSuno.playProjectTheme",
                "title": "AgenticSuno: Play Project Theme"
            }
        ],
        "configuration": {
            "title": "AgenticSuno",
            "properties": {
                "agenticSuno.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Suno API key (fallback engine)."
                },
                "agenticSuno.geminiApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Google Gemini API key used for Lyria realtime generation."
                },
                "agenticSuno.lyriaModel": {
                    "type": "string",
                    "default": "models/lyria-realtime-exp",
                    "description": "Lyria realtime model name."
                },
                "agenticSuno.lyriaStyleAnchor": {
                    "type": "string",
                    "default": "cinematic electronic soul with expressive harmonic movement, textured low-end groove, evolving melodic motifs, polished modern production, dynamic transitions, emotionally rich atmosphere",
                    "description": "Default style anchor text prepended to Lyria weighted prompts."
                },
                "agenticSuno.lyriaEvolutionStrength": {
                    "type": "string",
                    "enum": [
                        "subtle",
                        "balanced",
                        "strong"
                    ],
                    "default": "strong",
                    "description": "How strongly activity changes steer Lyria prompts and generation controls."
                },
                "agenticSuno.lyriaSkipVariation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.85,
                    "description": "How much skip introduces fresh variation while preserving style family."
                },
                "agenticSuno.engine": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "lyria",
                        "suno"
                    ],
                    "default": "auto",
                    "description": "Music engine selection. Auto prefers Lyria when geminiApiKey is configured."
                },
                "agenticSuno.autoPlayOnActivity": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically start playing music when AI agent activity is detected."
                },
                "agenticSuno.styles.working": {
                    "type": "string",
                    "default": "lo-fi beats, focus, coding",
                    "description": "Musical style for normal working state."
                },
                "agenticSuno.styles.error": {
                    "type": "string",
                    "default": "dark ambient, tension, cinematic",
                    "description": "Musical style for error state."
                },
                "agenticSuno.styles.success": {
                    "type": "string",
                    "default": "uplifting, epic, triumph",
                    "description": "Musical style for success state."
                },
                "agenticSuno.useMock": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use mock data instead of real Suno API (useful for testing or when API is down). When false and API key is set, real generation runs."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "agenticSuno-view",
                    "title": "AgenticSuno",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "agenticSuno-view": [
                {
                    "id": "agenticSuno.player",
                    "name": "Player",
                    "type": "webview",
                    "icon": "media/icon.svg"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "release:check": "bash ./scripts/check-marketplace-readiness.sh",
        "release:publish": "bash ./scripts/publish-extension.sh",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "^25.2.1",
        "@types/ws": "^8.5.14",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "@vscode/test-electron": "^2.3.2",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "mocha": "^10.2.0",
        "ts-loader": "^9.4.3",
        "typescript": "^5.9.3",
        "webpack": "^5.85.0",
        "webpack-cli": "^5.1.1"
    },
    "dependencies": {
        "axios": "^1.18.0",
        "ws": "^8.21.0"
    }
}
